# Tenrai v1 usa schema compatível com Jikan v4. O acesso público é sem chave.
# Nunca inclua Server Key no cliente Android/navegador.
VITE_CATALOG_BASE_URL=https://api.tenrai.org/v1

# Optional: only configure these public client values to enable Supabase auth/sync.
# Never put the Supabase service_role key in this file or in the mobile app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
